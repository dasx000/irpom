# Salin file ini menjadi .env.local, lalu isi dari dashboard Supabase
# proyek Monitoring IRPOM (Project Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key -- server-side only, JANGAN pernah diberi prefix
# NEXT_PUBLIC_. Dipakai untuk kelola akun admin (buat, reset sandi,
# nonaktifkan/blokir) lewat Supabase Auth Admin API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
